{
    "name": "Mini VDT Foundation Pose",
    "remoteUser": "void",
    "build": {
        "dockerfile": "Dockerfile",
        "args": {
            "USERNAME": "void"
        },
        "context": "..",
        "options": [
            "--progress", "plain", 
            "--secret", "id=PAT,src=.devcontainer/BUILDTOKEN"
        ]
    },
    "customizations": {
        "vscode": {
            "extensions":[
                "mutantdino.resourcemonitor",
                "Ranch-Hand-Robotics.rde-pack"
            ]
        }
    },
    "containerEnv": {
        "ROS_AUTOMATIC_DISCOVERY_RANGE": "SUBNET",
        "ROS_DOMAIN_ID": "42"
    },
    "privileged": true,
    "runArgs": [
        "--gpus=all",
        "--net=host",
        "--privileged"
    ]
}